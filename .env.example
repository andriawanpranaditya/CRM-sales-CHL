# Salin file ini menjadi .env.local untuk pengembangan lokal.
# Di Vercel, isi ketiganya di Project Settings -> Environment Variables.

# Connection string dari Neon (https://neon.tech) - pakai yang "pooled"
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Kunci rahasia sesi login - isi teks acak panjang (min 32 karakter)
AUTH_SECRET=ganti-dengan-teks-acak-panjang-minimal-32-karakter

# Kunci sekali pakai untuk membuat tabel & akun manager pertama
SETUP_KEY=ganti-dengan-kunci-rahasia-setup
